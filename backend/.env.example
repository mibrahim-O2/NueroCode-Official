SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CHROMA_DB_PATH=./chromadb
PISTON_API=http://localhost:2000/api/v2

APP_ENV=development
FRONTEND_URL=http://localhost:5173

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
ADMIN_EMAIL= 

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PROVIDER_SWITCH_PASSCODE=neurocode-dev-passcode

# Demo Mode — BOTH values are required before Demo Mode can be used at all.
# OWNER_EMAIL: the single login email allowed to see/use Demo Mode (the
# project owner's own account). Left blank, Demo Mode is refused for everyone.
#   e.g. OWNER_EMAIL=you@yourdomain.com
OWNER_EMAIL=
# DEMO_MODE_PASSCODE: entered once per browser session before Demo Mode can
# be switched on. Pick your own value — a blank passcode can never unlock it.
#   e.g. DEMO_MODE_PASSCODE=a-long-random-phrase-only-you-know
DEMO_MODE_PASSCODE=

# Assessment scoring/timing — leave as-is for production behavior.
INTEGRITY_PASS_THRESHOLD=60
ASSESSMENT_DURATION_SECONDS=2700